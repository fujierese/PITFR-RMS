<mxfile host="app.diagrams.net">
  <diagram name="Redundancy and Backup Diagram">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" connect="1" arrows="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- TITLE -->
        <mxCell id="title"
          value="PITFR – Redundancy and Backup Architecture"
          style="text;html=1;strokeColor=none;fillColor=#1e3a5f;fontColor=#ffffff;align=center;fontStyle=1;fontSize=16;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="800" height="50" as="geometry"/>
        </mxCell>

        <!-- USERS -->
        <mxCell id="users"
          value="Users"
          style="shape=ellipse;whiteSpace=wrap;html=1;"
          vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="160" height="80" as="geometry"/>
        </mxCell>

        <!-- PRIMARY SERVER -->
        <mxCell id="primary"
          value="Primary Server&#xa;(Application Server)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e6da4;fontColor=#ffffff;"
          vertex="1" parent="1">
          <mxGeometry x="300" y="200" width="220" height="100" as="geometry"/>
        </mxCell>

        <!-- BACKUP SERVER -->
        <mxCell id="backup"
          value="Backup Server&#xa;(Failover)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5a7a3a;fontColor=#ffffff;"
          vertex="1" parent="1">
          <mxGeometry x="300" y="340" width="220" height="100" as="geometry"/>
        </mxCell>

        <!-- PRIMARY DB -->
        <mxCell id="db1"
          value="Primary Database"
          style="shape=cylinder;whiteSpace=wrap;html=1;"
          vertex="1" parent="1">
          <mxGeometry x="580" y="200" width="160" height="90" as="geometry"/>
        </mxCell>

        <!-- BACKUP DB -->
        <mxCell id="db2"
          value="Backup Database"
          style="shape=cylinder;whiteSpace=wrap;html=1;"
          vertex="1" parent="1">
          <mxGeometry x="580" y="340" width="160" height="90" as="geometry"/>
        </mxCell>

        <!-- CONNECTIONS -->
        <mxCell id="e1" edge="1" parent="1" source="users" target="primary"
          style="endArrow=block;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2" edge="1" parent="1" source="primary" target="db1"
          style="endArrow=block;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e3" value="Replication"
          edge="1" parent="1" source="db1" target="db2"
          style="endArrow=block;dashed=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e4" value="Failover"
          edge="1" parent="1" source="primary" target="backup"
          style="endArrow=block;dashed=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>